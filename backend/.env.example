PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/delivery-app
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------------------------------
# Test database — deliberately separate from MONGO_URI above.
#
# `npm test` NEVER touches the database configured above. It runs the whole suite against an
# isolated, disposable database (and its own throwaway server instance on a different port —
# see test/runTests.js), defaulting to "delivery-app_test" with no configuration needed.
#
# `npm run seed` and `npm run db:reset` both use MONGO_URI (above) — seed is safe/non-destructive,
# db:reset is destructive by design and meant to target your real dev database on purpose.
#
# Override only if you need something other than the default test database name. Whatever value
# is used, the database name MUST end in "_test" or "-test" — the test suite refuses to run its
# destructive reset otherwise (see test/helpers.js: assertTestDatabase), so it can never fall
# back to wiping the database above by accident.
#
# Always run tests via `npm test` (never a single `npm run test:e2e:*` script against a dev server
# you started yourself with plain `npm run dev`) — the individual e2e suites now verify, over HTTP,
# that the server they're hitting proves itself to be the isolated test server before sending a
# single request (see test/testSafety.js), but `npm test` is what actually spins that server up.
# There is no TEST_MODE env var to set here — it's set automatically, only by test/runTests.js's
# own spawned server, and gates a test-only identity endpoint (app.js) that a real dev/prod
# process never exposes.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/delivery-app_test
# TEST_PORT=4100
