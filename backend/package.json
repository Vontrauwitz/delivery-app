{
  "name": "delivery-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Delivery App",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "test:e2e:phase2": "node test/e2e-phase2.js",
    "test:e2e:workshift": "node test/e2e-workshift.js",
    "test:e2e:replenishment": "node test/e2e-replenishment.js",
    "test:e2e:phase4": "node test/e2e-phase4.js",
    "test:unit:replenishment": "node test/unit-replenishment.js",
    "test:e2e": "npm run test:e2e:phase2 && npm run test:e2e:workshift && npm run test:e2e:replenishment && npm run test:e2e:phase4",
    "test": "npm run test:unit:replenishment && npm run test:e2e"
